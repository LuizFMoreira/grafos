# Configuração do Projeto: Análise de Colaboração em Repositórios GitHub

# ===== GITHUB API =====
# Token de autenticação para API do GitHub
# Gere em: https://github.com/settings/tokens
# Permissões necessárias: read:repo, read:org
GITHUB_TOKEN=your_github_token_here

# Tempo de espera em caso de rate limit (segundos)
GITHUB_RATE_LIMIT_WAIT=60

# ===== REPOSITÓRIO =====
# Repositório padrão a ser minerado (owner/repo)
DEFAULT_REPO_OWNER=Davii13
DEFAULT_REPO_NAME=Sistemas-de-aluguel-de-carros

# ===== LOGGING =====
# Nível de logging: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Arquivo de log
LOG_FILE=output/app.log

# ===== EXPORTAÇÃO =====
# Diretório padrão para exportação
OUTPUT_DIRECTORY=output

# Formato padrão: gexf, graphml, csv
DEFAULT_EXPORT_FORMAT=gexf

# ===== DESENVOLVIMENTO =====
# Modo de depuração (true/false)
DEBUG=false

# Modo teste (usa dados mock em vez de API)
TEST_MODE=false

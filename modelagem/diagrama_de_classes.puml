@startuml
title Diagrama de Classes - Análise de Colaboração no GitHub

' Cores diretas para compatibilidade máxima
skinparam classBackgroundColor<<abstract>> #87CEEB
skinparam classBackgroundColor<<concrete>> #90EE90
skinparam classBackgroundColor<<model>> #FFB6C1
skinparam classBackgroundColor<<service>> #FFD700
skinparam classBackgroundColor<<export>> #DDA0DD
skinparam classBackgroundColor<<api>> #FFA07A
skinparam classBackgroundColor<<exception>> #FFE4E1

' ============================================================================
' CAMADA MODEL - Estrutura de Dados (Fundacional)
' ============================================================================
package "Model" {
    class User <<model>> {
        -id: int
        -login: str
        ==
        +getId(): int
        +getLogin(): str
    }

    enum InteractionType <<model>> {
        ISSUE_CLOSE (1)
        ISSUE_COMMENT (2)
        PR_COMMENT (2)
        PR_APPROVAL (3)
        PR_REVIEW (4)
        PR_MERGE (5)
    }

    class Interaction <<model>> {
        -source: User
        -target: User
        -type: InteractionType
        -weight: float
        ==
        +getSource(): User
        +getTarget(): User
        +getType(): InteractionType
        +getWeight(): float
        +setWeight(float): void
    }

    class Edge <<model>> {
        -destination: int
        -weight: float
        ==
        +__init__(destination: int, weight: float)
        +getDestination(): int
        +getWeight(): float
        +increaseWeight(delta: float): void
    }
}

Interaction *-- User : source (composição)
Interaction *-- User : target (composição)
Interaction --> InteractionType : usa

' ============================================================================
' CAMADA EXCEPTION - Exceções Customizadas
' ============================================================================
package "Exceptions" {
    class InvalidVertexError <<exception>> {
        -vertex: int
        -vertexCount: int
        ==
        +__init__(vertex: int, vertexCount: int)
    }

    class SelfLoopError <<exception>> {
        -u: int
        -v: int
        ==
        +__init__(u: int, v: int)
    }

    class InvalidEdgeError <<exception>> {
        -u: int
        -v: int
        ==
        +__init__(u: int, v: int)
    }
}

' ============================================================================
' CAMADA GRAPH - Estrutura de Grafos (Core)
' ============================================================================
package "Graph" {
    abstract class AbstractGraph <<abstract>> {
        #vertexCount: int
        #edgeCount: int
        #vertexWeights: List
        #labels: List
        ==
        +AbstractGraph(vertexCount: int)
        +validateVertex(v: int): void
        +getVertexCount(): int
        +getEdgeCount(): int
        +isEmptyGraph(): bool
        +setVertexWeight(v: int, weight: float): void
        +getVertexWeight(v: int): float
        +setVertexLabel(v: int, label: str): void
        +getVertexLabel(v: int): str
        ==
        +{abstract} addEdge(u: int, v: int, weight: float): void
        +{abstract} removeEdge(u: int, v: int): void
        +{abstract} hasEdge(u: int, v: int): bool
        +{abstract} setEdgeWeight(u: int, v: int, weight: float): void
        +{abstract} getEdgeWeight(u: int, v: int): float
        +{abstract} getInDegree(v: int): int
        +{abstract} getOutDegree(v: int): int
        +{abstract} isSuccessor(u: int, v: int): bool
        +{abstract} isPredecessor(u: int, v: int): bool
        +{abstract} isConnected(): bool
        +{abstract} isCompleteGraph(): bool
    }

    class AdjacencyListGraph <<concrete>> {
        -adjacencyList: Dict
        ==
        +AdjacencyListGraph(vertexCount: int)
        +addEdge(u: int, v: int, weight: float): void
        +removeEdge(u: int, v: int): void
        +hasEdge(u: int, v: int): bool
        +getInDegree(v: int): int
        +getOutDegree(v: int): int
        +isConnected(): bool
    }

    class AdjacencyMatrixGraph <<concrete>> {
        -matrix: List
        ==
        +AdjacencyMatrixGraph(vertexCount: int)
        +addEdge(u: int, v: int, weight: float): void
        +removeEdge(u: int, v: int): void
        +hasEdge(u: int, v: int): bool
        +getInDegree(v: int): int
        +getOutDegree(v: int): int
        +isConnected(): bool
    }

    AdjacencyListGraph --|> AbstractGraph : herança
    AdjacencyMatrixGraph --|> AbstractGraph : herança
    AbstractGraph o-- Edge : contém (agregação)
}

' ============================================================================
' CAMADA API - Integração com GitHub
' ============================================================================
package "GitHub Miner" {
    class RateLimiter <<api>> {
        -limit: int
        -remaining: int
        -resetTime: int
        ==
        +RateLimiter(limit: int)
        +waitIfNeeded(): void
        +updateFromHeaders(headers: Dict): void
    }

    class GithubApiClient <<api>> {
        -token: str
        -owner: str
        -repo: str
        -rateLimiter: RateLimiter
        ==
        +GithubApiClient(token: str, owner: str, repo: str)
        +getIssues(): List
        +getPullRequests(): List
        +getComments(type: str): List
        +getReviews(): List
    }

    class DataTransformer <<api>> {
        -userMap: Dict
        ==
        +parseUsers(rawData: List): Dict
        +transformToInteraction(raw: Dict): Interaction
    }

    GithubApiClient *-- RateLimiter : possui (composição)
}

' ============================================================================
' CAMADA SERVICE - Lógica de Negócio
' ============================================================================
package "Service" {
    class GraphBuilderService <<service>> {
        -githubClient: GithubApiClient
        -graph: AbstractGraph
        -transformer: DataTransformer
        ==
        +GraphBuilderService(client: GithubApiClient, graph: AbstractGraph)
        +buildGraph(issues: List, prs: List, comments: List, reviews: List): AbstractGraph
    }

    class MetricsService <<service>> {
        -graph: AbstractGraph
        -cache: Dict
        ==
        +MetricsService(graph: AbstractGraph)
        +degreeCentrality(v: int): float
        +inDegree(v: int): int
        +outDegree(v: int): int
        +betweennessCentrality(v: int): float
        +closenessCentrality(v: int): float
        +pagerank(): Dict
        +clusteringCoefficient(v: int): float
        +density(): float
    }

    GraphBuilderService --> AbstractGraph : constrói
    GraphBuilderService --> GithubApiClient : utiliza
    GraphBuilderService --> DataTransformer : transforma
    MetricsService --> AbstractGraph : analisa
}

' ============================================================================
' CAMADA EXPORT - Exportação de Dados
' ============================================================================
package "Export" {
    abstract class BaseExporter <<abstract>> {
        #graph: AbstractGraph
        #filepath: str
        ==
        +BaseExporter(graph: AbstractGraph, filepath: str)
        +{abstract} export(): void
        #prepareNodes(): List
        #prepareEdges(): List
    }

    class CSVExporter <<concrete>> {
        -delimiter: str
        ==
        +export(): void
    }

    class GEXFExporter <<concrete>> {
        -version: str
        ==
        +export(): void
    }

    class GraphMLExporter <<concrete>> {
        -version: str
        ==
        +export(): void
    }

    CSVExporter --|> BaseExporter : herança
    GEXFExporter --|> BaseExporter : herança
    GraphMLExporter --|> BaseExporter : herança
    BaseExporter o-- AbstractGraph : processa (agregação)
}

' ============================================================================
' CAMADA APP - Orquestração Principal
' ============================================================================
package "App" {
    class AppConfig <<service>> {
        +owner: str
        +repo: str
        +token: str
        +outputDir: str
        +formats: List
        +verbose: bool
        ==
        +validate(): bool
    }

    class MainApp <<service>> {
        -config: AppConfig
        -githubClient: GithubApiClient
        -graph: AbstractGraph
        -builder: GraphBuilderService
        -metrics: MetricsService
        ==
        +MainApp(config: AppConfig)
        +run(): void
    }

    MainApp *-- AppConfig : configura (composição)
    MainApp --> GithubApiClient : cria
    MainApp --> AbstractGraph : instancia
    MainApp --> GraphBuilderService : utiliza
    MainApp --> MetricsService : utiliza
    MainApp --> BaseExporter : utiliza
}

' ============================================================================
' NOTAS E DOCUMENTAÇÃO
' ============================================================================

note right of AbstractGraph
    **Padrão: Template Method**

    Interface abstrata que define contrato
    para todas as implementações de grafos.

    **Restrições:**
    - Sem self-loops (u != v)
    - Sem múltiplas arestas
    - Idempotente: add_edge(u,v) 2x = acumula
    - Direcionado: u -> v
end note

note right of GraphBuilderService
    **Padrão: Service Layer**

    Orquestra transformação:
    dados GitHub -> Grafo ponderado

    **Pesos das Interações:**
    - Comentário: +2
    - Fechamento: +1
    - Aprovação: +3
    - Review: +4
    - Merge: +5
end note

note right of MetricsService
    **Padrão: Strategy**

    Implementa múltiplos algoritmos
    de análise de rede em Python puro.

    **Algoritmos:**
    - Degree, Betweenness, Closeness
    - PageRank (power iteration)
    - Eigenvector, Clustering
    - Densidade, Conectividade
end note

note right of BaseExporter
    **Padrão: Strategy + Template Method**

    Define interface para exportadores.
    Cada formato estende com lógica específica.

    **Formatos Suportados:**
    - CSV (simples, importável)
    - GEXF (Gephi nativo)
    - GraphML (interoperabilidade)
end note

note bottom
    **Relações UML:**
    --|> = Generalização (herança)
    o-- = Agregação (ciclo de vida independente)
    *-- = Composição (ciclo de vida vinculado)
    --> = Associação (utiliza/depende)
end note

@enduml
